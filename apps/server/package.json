{
  "name": "@webeditor/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @webeditor/domain build && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "pnpm --filter @webeditor/domain build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm --filter @webeditor/domain build && vitest run test/unit",
    "test:integration": "pnpm --filter @webeditor/domain build && vitest run test/integration"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@node-rs/argon2": "2.1.0",
    "@webeditor/domain": "workspace:*",
    "@webeditor/theme-core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "elkjs": "0.12.0",
    "fastify": "5.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
