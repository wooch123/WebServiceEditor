# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and build output
coverage/
dist/
test-results/
playwright-report/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local runtime data; keep directory markers and deterministic fixtures only
data/**
!data/.gitkeep

# generated evidence
artifacts/**
!artifacts/.gitkeep

# editor and package-manager caches
.vite/
.turbo/
.pnpm-store/
