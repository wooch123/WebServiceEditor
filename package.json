{
  "name": "webeditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @webeditor/server --filter @webeditor/web dev",
    "build": "pnpm -r --if-present build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "unit": "pnpm -r --if-present test:unit",
    "integration": "pnpm --filter @webeditor/server test:integration",
    "component": "pnpm --filter @webeditor/web test:component",
    "validation": "node --test tests/validation/*.test.mjs",
    "e2e": "playwright test",
    "test": "pnpm format && pnpm lint && pnpm typecheck && pnpm unit && pnpm integration && pnpm component && pnpm validation && pnpm build",
    "verify:phase0": "pnpm test && node scripts/verify-phase0.mjs",
    "verify:phase1": "pnpm test && node scripts/verify-phase1.mjs",
    "verify:phase2": "pnpm test && node scripts/verify-phase2.mjs",
    "verify:phase3": "pnpm test && node scripts/verify-phase3.mjs",
    "verify:phase4": "pnpm test && node scripts/verify-phase4.mjs",
    "verify:phase5": "pnpm test && node scripts/verify-phase5.mjs",
    "verify:phase6": "pnpm test && node scripts/verify-phase6.mjs",
    "verify:phase7": "pnpm test && node scripts/verify-phase7.mjs",
    "verify:phase8": "pnpm test && node scripts/verify-phase8.mjs",
    "verify:phase9": "pnpm test && node scripts/verify-phase9.mjs",
    "verify:phase10": "pnpm test && node scripts/verify-phase10.mjs",
    "verify:phase11": "pnpm test && node scripts/verify-phase11.mjs",
    "verify:phase12": "pnpm test && node scripts/verify-phase12.mjs",
    "verify:phase13": "pnpm test && node scripts/verify-phase13.mjs",
    "verify:phase14": "pnpm test && node scripts/verify-phase14.mjs",
    "verify:phase15": "pnpm test && node scripts/verify-phase15.mjs",
    "verify:phase16": "pnpm test && node scripts/verify-phase16.mjs",
    "verify:phase17": "pnpm test && node scripts/verify-phase17.mjs",
    "verify:phase18": "pnpm test && node scripts/verify-phase18.mjs",
    "verify:phase19": "pnpm test && node scripts/verify-phase19.mjs",
    "verify:phase20": "pnpm test && node scripts/verify-phase20.mjs",
    "verify:phase21": "pnpm test && node scripts/verify-phase21.mjs",
    "verify:phase22": "pnpm test && node scripts/verify-phase22.mjs",
    "verify:phase23": "pnpm test && node scripts/verify-phase23.mjs",
    "verify:phase23:local": "node scripts/verify-phase23-local.mjs",
    "verify:phase24": "pnpm test && node scripts/verify-phase24.mjs",
    "verify:phase25": "pnpm test && node scripts/verify-phase25.mjs",
    "test:corpus:generate": "pnpm --filter @webeditor/server corpus:generate",
    "test:corpus:verify": "pnpm --filter @webeditor/server corpus:verify",
    "verify:themes": "node scripts/verify-themes.mjs",
    "verify:theme-extension": "node scripts/verify-theme-extension.mjs",
    "verify:theme-provenance": "node scripts/verify-theme-provenance.mjs",
    "verify:completion-hygiene": "node scripts/verify-completion-hygiene.mjs",
    "build:release-reports": "node scripts/build-release-reports.mjs",
    "build:non-windows-final-audit": "node scripts/build-non-windows-final-audit.mjs",
    "build:final-release-report": "node scripts/build-final-release-report.mjs",
    "verify:corpus": "node scripts/verify-corpus.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
